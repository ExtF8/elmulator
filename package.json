{
    "name": "elmulator",
    "version": "2.4.5",
    "description": "calculator for Elmar",
    "author": "ExtF8",
    "main": "main.js",
    "desktopName": "com.extfield8.elmulator.desktop",
    "publish": [
        {
            "provider": "github",
            "owner": "ExtF8",
            "url": "https://github.com/ExtF8/elmulator/releases/"
        }
    ],
    "scripts": {
        "start": "export NODE_ENV=development&&electron .",
        "build": "rm -rfvd dist/ && electron-builder --linux --win"
    },
    "build": {
        "appId": "com.extfield8.elmulator",
        "productName": "Elmulator",
        "asar": true,
        "asarUnpack": [
            "tools/**"
        ],
        "linux": {
            "icon": "./images/icons/32x32.png",
            "category": "Utility",
            "target": [
                "snap"
            ],
            "electronLanguages": [
                "en-US"
            ],
            "syncDesktopName": true
        },
        "snapcraft": {
            "base": "core24",
            "core24": {
                "confinement": "strict"
            }
        },
        "win": {
            "artifactName": "Elmulator-${version}-${arch}.${ext}",
            "target": "nsis",
            "electronLanguages": [
                "en-US"
            ],
            "icon": "./images/icons/icon.ico",
            "compression": "maximum"
        },
        "copyright": "Copyright © 2025 ${author}"
    },
    "license": "MIT",
    "devDependencies": {
        "electron": "^44.9.1",
        "electron-builder": "^26.15.7",
        "electron-reloader": "^1.2.3"
    },
    "dependencies": {
        "@electron/asar": "^4.0.1",
        "@electron/packager": "^20.3.0",
        "electron-log": "^5.4.3",
        "electron-updater": "^6.8.9",
        "exceljs": "^3.4.0",
        "pdf-parse": "^1.1.4"
    }
}
